diff --git a/net/minecraft/server/network/ServerGamePacketListenerImpl.java b/net/minecraft/server/network/ServerGamePacketListenerImpl.java
index 404186dfa4f0c0c2caec9ee9faef89b28a8e3668..88f2f289f3a4a07c62f22b9eab3212078706d4d0 100644
--- a/net/minecraft/server/network/ServerGamePacketListenerImpl.java
+++ b/net/minecraft/server/network/ServerGamePacketListenerImpl.java
@@ -540,7 +540,16 @@ public class ServerGamePacketListenerImpl
             }
         }
         // Paper end - PlayerToggleSneakEvent
-        this.player.setLastClientInput(packet.input());
+        // DeerFoliaPlus start - posture exit keys and movement lock
+        net.minecraft.world.entity.player.Input deerFoliaPlusInput = packet.input();
+        boolean movementLocked = cn.lunadeer.mc.deerfoliaplus.posture.PostureService.getInstance().isMovementLocked(this.getCraftPlayer());
+        if (movementLocked && (deerFoliaPlusInput.shift() || deerFoliaPlusInput.jump())) {
+            cn.lunadeer.mc.deerfoliaplus.posture.PostureService.getInstance().getUp(this.getCraftPlayer());
+        } else if (movementLocked) {
+            deerFoliaPlusInput = net.minecraft.world.entity.player.Input.EMPTY;
+        }
+        this.player.setLastClientInput(deerFoliaPlusInput);
+        // DeerFoliaPlus end - posture exit keys and movement lock
         if (this.hasClientLoaded()) {
             this.player.resetLastActionTime();
             // this.player.setShiftKeyDown(packet.input().shift()); // Paper - move up and only set if event is not cancelled.
@@ -1552,6 +1561,20 @@ public class ServerGamePacketListenerImpl
                         double targetX = clampHorizontal(packet.getX(this.player.getX()));
                         double targetY = clampVertical(packet.getY(this.player.getY()));
                         double targetZ = clampHorizontal(packet.getZ(this.player.getZ()));
+                        // DeerFoliaPlus start - lock lying movement in place
+                        if (!this.player.isPassenger() && cn.lunadeer.mc.deerfoliaplus.posture.PostureService.getInstance().isLying(this.getCraftPlayer())) {
+                            org.bukkit.Location lockedLocation = cn.lunadeer.mc.deerfoliaplus.posture.PostureService.getInstance().getLockedLocation(this.getCraftPlayer());
+                            if (lockedLocation != null && packet.hasPosition()) {
+                                double lockDeltaX = targetX - lockedLocation.getX();
+                                double lockDeltaY = targetY - lockedLocation.getY();
+                                double lockDeltaZ = targetZ - lockedLocation.getZ();
+                                if (Math.abs(lockDeltaX) > 1.0E-4 || Math.abs(lockDeltaY) > 1.0E-4 || Math.abs(lockDeltaZ) > 1.0E-4) {
+                                    this.internalTeleport(lockedLocation.getX(), lockedLocation.getY(), lockedLocation.getZ(), targetYRot, targetXRot);
+                                    return;
+                                }
+                            }
+                        }
+                        // DeerFoliaPlus end - lock lying movement in place
                         if (this.player.isPassenger()) {
                             this.player.absSnapTo(this.player.getX(), this.player.getY(), this.player.getZ(), targetYRot, targetXRot);
                             this.player.level().getChunkSource().move(this.player);
diff --git a/net/minecraft/world/entity/player/Player.java b/net/minecraft/world/entity/player/Player.java
index 2d234a7063381b36ffbc0c4e6e339d2c3f3ae76c..0605ed161dbffd69861e3dbdccff8d7266e3ee9c 100644
--- a/net/minecraft/world/entity/player/Player.java
+++ b/net/minecraft/world/entity/player/Player.java
@@ -367,6 +367,18 @@ public abstract class Player extends Avatar implements ContainerUser {
     }
 
     protected void updatePlayerPose() {
+        // DeerFoliaPlus start - forced crawl and lay poses
+        if (this.getBukkitEntity() instanceof org.bukkit.entity.Player bukkitPlayer) {
+            if (cn.lunadeer.mc.deerfoliaplus.posture.PostureService.getInstance().isCrawling(bukkitPlayer)) {
+                this.setPose(Pose.SWIMMING);
+                return;
+            }
+            if (cn.lunadeer.mc.deerfoliaplus.posture.PostureService.getInstance().isLying(bukkitPlayer)) {
+                this.setPose(Pose.SLEEPING);
+                return;
+            }
+        }
+        // DeerFoliaPlus end - forced crawl and lay poses
         if (this.canPlayerFitWithinBlocksAndEntitiesWhen(Pose.SWIMMING)) {
             Pose desiredPose = this.getDesiredPose();
             Pose actualPose;
@@ -1524,6 +1536,14 @@ public abstract class Player extends Avatar implements ContainerUser {
 
     @Override
     public void travel(final Vec3 input) {
+        // DeerFoliaPlus start - lock posture movement travel
+        if (!this.isPassenger() && this.getBukkitEntity() instanceof org.bukkit.entity.Player bukkitPlayer
+                && cn.lunadeer.mc.deerfoliaplus.posture.PostureService.getInstance().isMovementLocked(bukkitPlayer)) {
+            super.travel(Vec3.ZERO);
+            return;
+        }
+        // DeerFoliaPlus end - lock posture movement travel
+
         if (this.isPassenger()) {
             super.travel(input);
         } else {
