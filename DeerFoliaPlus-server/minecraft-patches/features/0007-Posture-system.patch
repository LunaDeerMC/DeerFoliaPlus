diff --git a/net/minecraft/server/network/ServerGamePacketListenerImpl.java b/net/minecraft/server/network/ServerGamePacketListenerImpl.java
index 5eb9c9488c1c87c588c2c0426f416f348ce1fe0b..bf40fe3ed7238e5af0f817e2afc4804e30aa3b95 100644
--- a/net/minecraft/server/network/ServerGamePacketListenerImpl.java
+++ b/net/minecraft/server/network/ServerGamePacketListenerImpl.java
@@ -550,7 +550,16 @@ public class ServerGamePacketListenerImpl
             }
         }
         // Paper end - PlayerToggleSneakEvent
-        this.player.setLastClientInput(packet.input());
+        // DeerFoliaPlus start - posture exit keys and movement lock
+        net.minecraft.world.entity.player.Input deerFoliaPlusInput = packet.input();
+        boolean movementLocked = cn.lunadeer.mc.deerfoliaplus.posture.PostureService.getInstance().isMovementLocked(this.getCraftPlayer());
+        if (movementLocked && (deerFoliaPlusInput.shift() || deerFoliaPlusInput.jump())) {
+            cn.lunadeer.mc.deerfoliaplus.posture.PostureService.getInstance().getUp(this.getCraftPlayer());
+        } else if (movementLocked) {
+            deerFoliaPlusInput = net.minecraft.world.entity.player.Input.EMPTY;
+        }
+        this.player.setLastClientInput(deerFoliaPlusInput);
+        // DeerFoliaPlus end - posture exit keys and movement lock
         if (this.hasClientLoaded()) {
             if (deerFoliaInputChanged) {
                 cn.lunadeer.mc.deerfolia.afknetwork.AfkNetworkManager.handleBaseActivity(this.player); // DeerFolia - AFK network optimization
@@ -868,7 +877,7 @@ public class ServerGamePacketListenerImpl
             this.lastGoodZ = this.awaitingPositionFromClient.z;
             this.player.hasChangedDimension();
             this.awaitingPositionFromClient = null;
-            this.handlePlayerPositionChange(packet.x(), packet.y(), packet.z(), packet.yRot(), packet.xRot(), false, false);
+            this.handlePlayerPositionChange(packet.x(), packet.y(), packet.z(), packet.yRot(), packet.xRot(), false, false, true); // DeerFoliaPlus - posture position lock
         }
     }
 
@@ -1575,7 +1584,8 @@ public class ServerGamePacketListenerImpl
                             requestedYRot,
                             requestedXRot,
                             packet.isOnGround(),
-                            packet.horizontalCollision()
+                            packet.horizontalCollision(),
+                            packet.hasPosition() // DeerFoliaPlus - preserve rotation-only movement semantics
                         );
                     }
                 }
@@ -1590,13 +1600,28 @@ public class ServerGamePacketListenerImpl
         final float requestedYRot,
         final float requestedXRot,
         final boolean isOnGround,
-        final boolean horizontalCollision
+        final boolean horizontalCollision,
+        final boolean hasPosition // DeerFoliaPlus - posture position lock
     ) {
         double targetX = clampHorizontal(requestedX);
         double targetY = clampVertical(requestedY);
         double targetZ = clampHorizontal(requestedZ);
         float targetYRot = Mth.wrapDegrees(requestedYRot);
         float targetXRot = Mth.wrapDegrees(requestedXRot);
+        // DeerFoliaPlus start - lock lying movement in place
+        if (hasPosition && !this.player.isPassenger() && cn.lunadeer.mc.deerfoliaplus.posture.PostureService.getInstance().isLying(this.getCraftPlayer())) {
+            org.bukkit.Location lockedLocation = cn.lunadeer.mc.deerfoliaplus.posture.PostureService.getInstance().getLockedLocation(this.getCraftPlayer());
+            if (lockedLocation != null) {
+                double lockDeltaX = targetX - lockedLocation.getX();
+                double lockDeltaY = targetY - lockedLocation.getY();
+                double lockDeltaZ = targetZ - lockedLocation.getZ();
+                if (Math.abs(lockDeltaX) > 1.0E-4 || Math.abs(lockDeltaY) > 1.0E-4 || Math.abs(lockDeltaZ) > 1.0E-4) {
+                    this.internalTeleport(lockedLocation.getX(), lockedLocation.getY(), lockedLocation.getZ(), targetYRot, targetXRot);
+                    return;
+                }
+            }
+        }
+        // DeerFoliaPlus end - lock lying movement in place
         if (this.player.isPassenger()) {
             this.player.absSnapTo(this.player.getX(), this.player.getY(), this.player.getZ(), targetYRot, targetXRot);
             this.player.level().getChunkSource().move(this.player);
diff --git a/net/minecraft/world/entity/player/Player.java b/net/minecraft/world/entity/player/Player.java
